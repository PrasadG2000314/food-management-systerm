        {
          "name": "Get All Users (Filtered & Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/users?role=All&status=Active&search=",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "users"],
              "query": [
                { "key": "role", "value": "All" },
                { "key": "status", "value": "Active" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },

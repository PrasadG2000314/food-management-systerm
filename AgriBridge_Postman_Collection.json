            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"ORD-9800\",\n  \"farmerName\": \"Sunil Bandara\",\n  \"farmerId\": \"usr-002\",\n  \"buyerName\": \"Lanka Fresh Superstores\",\n  \"buyerId\": \"usr-004\",\n  \"produce\": \"Organic Strawberries & Leeks\",\n  \"quantityKg\": 800,\n  \"crates\": 32,\n  \"pickupDistrict\": \"Nuwara Eliya\",\n  \"pickupAddress\": \"Hakgala Road Farm Gate\",\n  \"dropoffDistrict\": \"Colombo\",\n  \"dropoffAddress\": \"Kollupitiya Supermarket Terminal\",\n  \"priority\": \"High\",\n  \"requiresRefrigeration\": true\n}"
